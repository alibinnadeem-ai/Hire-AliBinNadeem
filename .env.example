# ─────────────────────────────────────────────────────────
#  ABN CONSULTANT — Environment Variables
#  cp .env.example .env  then fill in values
# ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# ── PostgreSQL ──
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abn_consultant
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=true

# ── JWT ──
JWT_SECRET=consultant_jwt_secret_change_this_min_32_chars
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=consultant_admin_secret_change_this

# ── Admin ──
ADMIN_EMAIL=alibinnadeem.official@gmail.com
ADMIN_PASSWORD_HASH=bcrypt_hash_of_your_password

# ── SMTP (Hostinger) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@binnadeem.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=Ali Bin Nadeem <contact@binnadeem.com>
EMAIL_TO=alibinnadeem.official@gmail.com

# ── CORS ──
CORS_ORIGIN=https://consultant.alibinnadeem.com,http://localhost:3002

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Consulting-specific ──
CALENDLY_USERNAME=alibinnadeem
CALENDLY_API_KEY=your_calendly_api_key
QCCD_API_URL=https://qccd.net/api
QCCD_API_KEY=your_qccd_key
QCCD_PARTNER_ID=abn-360lead
PSDF_ORG_ID=360-lead-solutions

# ── Integrations ──
ARD_CRM_WEBHOOK_URL=https://ardcrm.vercel.app/api/webhook
ARD_CRM_API_KEY=your_ard_crm_key
SYNTIANT_API_URL=https://syntiantatlas-web.vercel.app/api
SYNTIANT_API_KEY=your_syntiant_key

# ── LinkedIn OAuth ──
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=https://your-vercel-domain.vercel.app/api/auth/linkedin/callback

# ── Analytics ──
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
